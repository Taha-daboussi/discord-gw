def cmd_login(args):
    env = dict(os.environ, BU_NAME="dgw-login", BH_TAB_MARKER="0")
    script = LOGIN_SCRIPT.replace("AUTH_PATH\n", repr(str(AUTH)) + "\n", 1)
    out = subprocess.run(["browser-harness"], input=script, text=True, capture_output=True, env=env, cwd=HOME)
    subprocess.run(["browser-harness", "--reload"], env=env, cwd=HOME, capture_output=True)
    if "LOGIN-OK" not in out.stdout:
        print("login failed:", (out.stdout + out.stderr).strip()[-800:], file=sys.stderr)
        return 1
    con = db_connect()
    Recorder(con, {}).meta(state="restarting")
    subprocess.run(["systemctl", "--user", "restart", SERVICE], check=False)
    print(f"saved a fresh token in {AUTH} (mode 600) and restarted {SERVICE}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="discord-gw", description=USAGE, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("daemon")
    sub.add_parser("status")
    sub.add_parser("login")
    r = sub.add_parser("read")
    r.add_argument("--channel")
    g = r.add_mutually_exclusive_group()
    g.add_argument("--since-msg", type=int, help="this message and every message after it")
    g.add_argument("--around", type=int, help="--last messages before and after this message")
    r.add_argument("--last", type=int, default=25)
    r.add_argument("--json", action="store_true")
    w = sub.add_parser("wait")
    w.add_argument("--channel")
    g = w.add_mutually_exclusive_group()
    g.add_argument("--since-msg", type=int, help="events after this message (your question)")
    g.add_argument("--cursor", type=int, help="events after this cursor (from the last read or wait)")
    w.add_argument("--timeout", type=parse_duration, default=parse_duration("60m"))
    w.add_argument("--batch", type=parse_duration, default=parse_duration("30s"), help="after the first event, wait this long for more")
    w.add_argument("--others", action="store_true", help="skip the events of the account itself")
    w.add_argument("--json", action="store_true")
    t = sub.add_parser("thread")
    t.add_argument("msg_id", type=int)
    t.add_argument("--channel")
    sub.add_parser("media").add_argument("msg_id", type=int)
    args = ap.parse_args()
    handlers = {
        "daemon": cmd_daemon, "status": cmd_status, "login": cmd_login,
        "read": cmd_read, "wait": cmd_wait, "thread": cmd_thread, "media": cmd_media,
    }
    sys.exit(handlers[args.cmd](args))


if __name__ == "__main__":
    main()
